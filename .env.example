# mucajey Backend Configuration

# Server Port
PORT=3000

# API Key für geschützte Endpoints
# Generiere einen sicheren API-Key für Production!
API_KEY=mucajey-dev-key-2024

# Spotify API Credentials
# Erstelle eine App auf https://developer.spotify.com/dashboard
# und füge Client ID und Client Secret hier ein
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Apple Music Developer Token (z.B. aus scripts/generate_token.js)
APPLE_MUSIC_API_TOKEN=
APPLE_MUSIC_STORE=de
