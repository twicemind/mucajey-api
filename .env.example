# mucajey API Configuration

# Server Port
PORT=3000

# API Key für geschützte Endpoints
# Generiere einen sicheren API-Key für Production!
API_KEY=mucajey-dev-key-2024

# Spotify API Credentials
# Erstelle eine App auf https://developer.spotify.com/dashboard
# und füge Client ID und Client Secret hier ein
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Apple Music Developer Token (z.B. aus scripts/generate_token.js)
APPLE_MUSIC_API_TOKEN=your_apple_music_api_token_here
APPLE_MUSIC_STORE=de

# Gemeinsamer Host (kann auch ein Cluster-URI sein)
MONGODB_HOST=localhost:21017

# DB 1: mucajey
MONGODB_MUCAJEY_DB=mucajey
MONGODB_MUCAJEY_USER=mucajey-app-db-user
MONGODB_MUCAJEY_PASS=your_database_user_password_here
MONGODB_MUCAJEY_AUTH_SOURCE=mucajey

# DB 2: mucajey-data
MONGODB_MUCAJEYDATA_DB=mucajey-data
MONGODB_MUCAJEYDATA_USER=mucajey-app-db-user
MONGODB_MUCAJEYDATA_PASS=your_database_user_password_here
MONGODB_MUCAJEYDATA_AUTH_SOURCE=mucajey-data