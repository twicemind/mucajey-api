// Route: Alle verfügbaren Dateien auflisten
app.get('/api/files', authenticateApiKey, async (req, res) => {
  try {
    const files = await fs.readdir(DATA_DIR);
    const jsonFiles = files.filter(file => file.endsWith('.json'));
    res.json({ files: jsonFiles });
  } catch (error) {
    res.status(500).json({ error: 'Fehler beim Laden der Dateien', details: error.message });
  }
});

// Route: Alle Daten aus allen JSON-Dateien zusammenführen
app.get('/api/all-data', authenticateApiKey, async (req, res) => {
  try {
    const files = await fs.readdir(DATA_DIR);
    const jsonFiles = files.filter(file => 
      file.endsWith('.json') && 
      file.startsWith('hitster-de') &&
      !file.includes('import')
    );
    
    let allCards = [];
    let editions = [];
    
    // Lade alle Dateien und sammle Karten
    for (const file of jsonFiles) {
      try {
        const data = await loadJsonFile(file);
        
        // Sammle Edition-Info
        if (data.edition && !editions.some(e => e.edition === data.edition)) {
          editions.push({
            edition: data.edition,
            language_short: data.language_short || 'de',
            language_long: data.language_long || 'Deutsch',
            identifier: data.identifier || '',
            file: file,
            cardCount: data.cards ? data.cards.length : 0
          });
        }
        
        // Sammle ALLE Karten aus ALLEN Editionen (keine Duplikat-Prüfung!)
        if (data.cards && Array.isArray(data.cards)) {
          for (const card of data.cards) {
            allCards.push({
              ...card,
              edition: data.edition || 'Unknown',
              language_short: data.language_short || 'de',
              language_long: data.language_long || 'Deutsch',
              source_file: file
            });
          }
        }
      } catch (fileError) {
        console.error(`Fehler beim Laden von ${file}:`, fileError.message);
        // Weiter mit nächster Datei
      }
    }
    
    res.json({
      summary: {
        totalCards: allCards.length,
        totalEditions: editions.length,
        totalFiles: jsonFiles.length
      },
      editions: editions,
      cards: allCards
    });
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Laden aller Daten', 
      details: error.message 
    });
  }
});

// Route: Alle Daten aus hitster-de.json
app.get('/api/hitster-de', authenticateApiKey, async (req, res) => {
  try {
    const data = await loadJsonFile('hitster-de.json');
    res.json(data);
  } catch (error) {
    res.status(500).json({ error: 'Fehler beim Laden der Daten', details: error.message });
  }
});

// Route: Spezifische Datei laden
app.get('/api/data/:filename', authenticateApiKey, async (req, res) => {
  try {
    const filename = req.params.filename;
    
    // Sicherheitscheck: Nur .json Dateien
    if (!filename.endsWith('.json')) {
      return res.status(400).json({ error: 'Nur JSON-Dateien erlaubt' });
    }
    
    const data = await loadJsonFile(filename);
    res.json(data);
  } catch (error) {
    if (error.code === 'ENOENT') {
      res.status(404).json({ error: 'Datei nicht gefunden' });
    } else {
      res.status(500).json({ error: 'Fehler beim Laden der Datei', details: error.message });
    }
  }
});

// Route: Karten nach Jahr filtern
app.get('/api/cards/year/:year', authenticateApiKey, async (req, res) => {
  try {
    const year = req.params.year;
    const data = await loadJsonFile('hitster-de.json');
    
    const filteredCards = data.cards.filter(card => card.year === year);
    res.json({
      edition: data.edition,
      year: year,
      count: filteredCards.length,
      cards: filteredCards
    });
  } catch (error) {
    res.status(500).json({ error: 'Fehler beim Filtern der Daten', details: error.message });
  }
});

// Route: Karte nach ID suchen
app.get('/api/cards/:id', authenticateApiKey, async (req, res) => {
  try {
    const cardId = req.params.id;
    const data = await loadJsonFile('hitster-de.json');
    
    const card = data.cards.find(c => c.id === cardId);
    
    if (card) {
      res.json(card);
    } else {
      res.status(404).json({ error: 'Karte nicht gefunden' });
    }
  } catch (error) {
    res.status(500).json({ error: 'Fehler beim Suchen der Karte', details: error.message });
  }
});

// Route: Gescannte Karte abrufen (Scan-Code Format: /scan/:edition/:cardId)
app.get('/scan/:edition/:cardId', authenticateApiKey, async (req, res) => {
  try {
    const { edition, cardId } = req.params;
    
    // Dateiname basierend auf Edition erstellen
    const filename = `hitster-de-${edition}.json`;
    
    let data;
    try {
      // Versuche spezifische Edition zu laden
      data = await loadJsonFile(filename);
    } catch (error) {
      if (error.code === 'ENOENT') {
        // Falls Edition nicht gefunden, versuche in Haupt-Datei zu suchen
        data = await loadJsonFile('hitster-de.json');
      } else {
        throw error;
      }
    }
    
    // Karte in den Daten suchen
    const card = data.cards.find(c => c.id === cardId);
    
    if (card) {
      res.json({
        edition: data.edition || edition,
        scanCode: `${edition}/${cardId}`,
        card: card
      });
    } else {
      res.status(404).json({ 
        error: 'Karte nicht gefunden',
        scanCode: `${edition}/${cardId}`,
        edition: edition,
        cardId: cardId
      });
    }
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Laden der gescannten Karte', 
      details: error.message 
    });
  }
});

