});

// Route: Apple Music Daten zu einer Karte hinzufügen/aktualisieren
app.patch('/api/cards/:edition/:cardId/apple', authenticateApiKey, async (req, res) => {
  try {
    const { edition, cardId } = req.params;
    const { appleId, appleUri } = req.body;

    if (!appleId && !appleUri) {
      return res.status(400).json({ 
        error: 'Entweder appleId oder appleUri muss angegeben werden' 
      });
    }

    // Bestimme den Dateinamen
    let filename;
    if (edition === 'hitster-de' || edition === '') {
      filename = 'hitster-de.json';
    } else {
      filename = `hitster-de-${edition}.json`;
    }

    // Lade die Datei
    const data = await loadJsonFile(filename);
    
    // Finde die Karte
    const cardIndex = data.cards.findIndex(c => c.id === cardId);
    
    if (cardIndex === -1) {
      return res.status(404).json({ 
        error: 'Karte nicht gefunden',
        edition: edition,
        cardId: cardId,
        file: filename
      });
    }

    // Aktualisiere die Apple Music Daten
    if (!data.cards[cardIndex].apple) {
      data.cards[cardIndex].apple = {};
    }
    
    if (appleId !== undefined) {
      data.cards[cardIndex].apple.id = appleId;
    }
    if (appleUri !== undefined) {
      data.cards[cardIndex].apple.uri = appleUri;
    }

    // Speichere die aktualisierte Datei
    const filePath = path.join(DATA_DIR, filename);
    await fs.writeFile(filePath, JSON.stringify(data, null, 2), 'utf-8');

    res.json({
      message: 'Apple Music Daten erfolgreich aktualisiert',
      card: data.cards[cardIndex],
      file: filename
    });
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Aktualisieren der Apple Music Daten', 
      details: error.message 
    });
  }
});

// Route: Apple Music Daten für mehrere Karten aktualisieren (Batch)
app.patch('/api/cards/apple/batch', authenticateApiKey, async (req, res) => {
  try {
    const { updates } = req.body;

    if (!Array.isArray(updates) || updates.length === 0) {
      return res.status(400).json({ 
        error: 'updates Array muss angegeben werden und darf nicht leer sein',
        example: {
          updates: [
            { edition: "aaaa0007", cardId: "00001", appleId: "123456", appleUri: "https://..." }
          ]
        }
      });
    }

    const results = {
      success: [],
      failed: []
    };

    // Gruppiere Updates nach Datei für effizientes Speichern
    const fileUpdates = {};
    
    for (const update of updates) {
      const { edition, cardId, appleId, appleUri } = update;
      
      if (!edition || !cardId) {
        results.failed.push({ 
          edition, 
          cardId, 
          error: 'edition und cardId sind erforderlich' 
        });
        continue;
      }

      let filename;
      if (edition === 'hitster-de' || edition === '') {
        filename = 'hitster-de.json';
      } else {
        filename = `hitster-de-${edition}.json`;
      }

      if (!fileUpdates[filename]) {
        try {
          fileUpdates[filename] = await loadJsonFile(filename);
        } catch (error) {
          results.failed.push({ 
            edition, 
            cardId, 
            error: `Datei ${filename} konnte nicht geladen werden` 
          });
          continue;
        }
      }

      const data = fileUpdates[filename];
      const cardIndex = data.cards.findIndex(c => c.id === cardId);

      if (cardIndex === -1) {
        results.failed.push({ 
          edition, 
          cardId, 
          error: 'Karte nicht gefunden' 
        });
        continue;
      }

      // Aktualisiere die Apple Music Daten
      if (!data.cards[cardIndex].apple) {
        data.cards[cardIndex].apple = {};
      }
      
      if (appleId !== undefined) {
        data.cards[cardIndex].apple.id = appleId;
      }
      if (appleUri !== undefined) {
        data.cards[cardIndex].apple.uri = appleUri;
      }

      results.success.push({ 
        edition, 
        cardId, 
        file: filename 
      });
    }

    // Speichere alle aktualisierten Dateien
    for (const [filename, data] of Object.entries(fileUpdates)) {
      const filePath = path.join(DATA_DIR, filename);
      await fs.writeFile(filePath, JSON.stringify(data, null, 2), 'utf-8');
    }

    res.json({
      message: `${results.success.length} Karten erfolgreich aktualisiert`,
      summary: {
        total: updates.length,
        success: results.success.length,
        failed: results.failed.length,
        filesUpdated: Object.keys(fileUpdates).length
      },
      results: results
    });
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Batch-Update der Apple Music Daten', 
      details: error.message 
    });
  }
});

// Route: Neue Datei erstellen
app.post('/api/files', authenticateApiKey, async (req, res) => {
  try {
    const { edition, identifier, language_short, language_long } = req.body;

    // Validierung
    if (!edition || !identifier) {
      return res.status(400).json({ 
        error: 'Validierungsfehler',
        message: 'edition und identifier sind erforderlich',
        example: {
          edition: "Hitster Deutschland Test Edition",
          identifier: "aaaa0099",
          language_short: "de",
          language_long: "Deutsch"
        }
      });
    }

    // Validiere identifier Format (8 Zeichen)
    if (!/^[a-z0-9]{8}$/.test(identifier)) {
      return res.status(400).json({ 
        error: 'Validierungsfehler',
        message: 'identifier muss genau 8 Zeichen (a-z, 0-9) lang sein, z.B. "aaaa0099"'
      });
    }

    // Generiere Dateinamen
    const filename = `hitster-de-${identifier}.json`;
    const filePath = path.join(DATA_DIR, filename);

    // Prüfe ob Datei bereits existiert
    try {
      await fs.access(filePath);
      return res.status(409).json({ 
        error: 'Datei existiert bereits',
        message: `Eine Datei mit dem identifier "${identifier}" existiert bereits`,
        filename: filename
      });
    } catch {
      // Datei existiert nicht, gut!
    }

    // Erstelle initiale Struktur
    const initialData = {
      edition: edition,
      language_short: language_short || 'de',
      language_long: language_long || 'Deutsch',
      identifier: identifier,
      cards: []
    };

    // Speichere neue Datei
    await fs.writeFile(filePath, JSON.stringify(initialData, null, 2), 'utf-8');

    res.status(201).json({
      message: 'Datei erfolgreich erstellt',
      filename: filename,
      data: initialData
    });
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Erstellen der Datei', 
      details: error.message 
    });
  }
});

// Route: Neue Card zu einer Edition hinzufügen
app.post('/api/files/:filename/cards', authenticateApiKey, async (req, res) => {
  try {
    const { filename } = req.params;
    const newCard = req.body;

    // Validierung
    if (!newCard.id || !newCard.title || !newCard.artist || !newCard.year) {
      return res.status(400).json({ 
        error: 'Validierungsfehler',
        message: 'id, title, artist und year sind erforderlich',
        example: {
          id: "00001",
          title: "Song Title",
          artist: "Artist Name",
          year: "2020",
          apple: { id: "", uri: "" },
          spotify: { id: "", uri: "" }
        }
      });
    }

    // Datei laden
    const filePath = path.join(DATA_DIR, filename);
    
    try {
      await fs.access(filePath);
    } catch {
      return res.status(404).json({ 
        error: 'Datei nicht gefunden',
        message: `Die Datei "${filename}" existiert nicht`
      });
    }

    const fileContent = await fs.readFile(filePath, 'utf-8');
    const data = JSON.parse(fileContent);

    // Prüfe ob Card-ID bereits existiert
    const existingCard = data.cards.find(c => c.id === newCard.id);
    if (existingCard) {
      return res.status(409).json({ 
        error: 'Card existiert bereits',
        message: `Eine Card mit der ID "${newCard.id}" existiert bereits in dieser Edition`
      });
    }

    // Card-Struktur vorbereiten mit vollständiger Struktur
    const card = {
      id: newCard.id,
      title: newCard.title,
      artist: newCard.artist,
      year: newCard.year,
      apple: {
        id: newCard.apple?.id || "",
        uri: newCard.apple?.uri || ""
      },
      spotify: {
        id: newCard.spotify?.id || "",
        uri: newCard.spotify?.uri || "",
        url: newCard.spotify?.url || ""
      }
    };

    // Card hinzufügen
    data.cards.push(card);

    // Datei speichern
    await fs.writeFile(filePath, JSON.stringify(data, null, 2), 'utf-8');

    res.status(201).json({
      message: 'Card erfolgreich hinzugefügt',
      filename: filename,
      edition: data.edition,
      card: card,
      totalCards: data.cards.length
    });
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Hinzufügen der Card', 
      details: error.message 
    });
  }
});

// Route: Card aktualisieren (PUT /api/files/:filename/cards/:cardId)
app.put('/api/files/:filename/cards/:cardId', authenticateApiKey, async (req, res) => {
  try {
    const { filename, cardId } = req.params;
    const updateData = req.body;

    // Validierung: Filename muss hitster-de-*.json sein
    if (!filename.match(/^hitster-de-[a-z0-9]{8}\.json$/)) {
      return res.status(400).json({ 
        error: 'Ungültiger Dateiname',
        message: 'Dateiname muss dem Muster hitster-de-xxxxxxxx.json entsprechen'
      });
    }

    const filePath = path.join(DATA_DIR, filename);

    // Prüfe ob Datei existiert
    try {
      await fs.access(filePath);
    } catch {
      return res.status(404).json({ 
        error: 'Datei nicht gefunden',
        filename: filename 
      });
    }

    // Datei laden
    const fileContent = await fs.readFile(filePath, 'utf-8');
    const data = JSON.parse(fileContent);

    // Card finden
    const cardIndex = data.cards.findIndex(c => c.id === cardId);
    
    if (cardIndex === -1) {
      return res.status(404).json({ 
        error: 'Card nicht gefunden',
        cardId: cardId,
        filename: filename
      });
    }

    // Bestehende Card
    const existingCard = data.cards[cardIndex];

    // Update-Daten vorbereiten - nur erlaubte Felder aktualisieren
    const updatedCard = {
      ...existingCard,
      ...(updateData.title && { title: updateData.title }),
      ...(updateData.artist && { artist: updateData.artist }),
      ...(updateData.year && { year: updateData.year })
    };

    // Spotify-Daten aktualisieren
    if (updateData.spotify !== undefined) {
      if (updateData.spotify === null) {
        // Spotify-Daten entfernen
        updatedCard.spotify = { id: "", uri: "", url: "" };
      } else {
        updatedCard.spotify = {
          id: updateData.spotify.id || existingCard.spotify?.id || "",
          uri: updateData.spotify.uri || existingCard.spotify?.uri || "",
          url: updateData.spotify.url || existingCard.spotify?.url || ""
        };
      }
    }

    // Apple-Daten aktualisieren
    if (updateData.apple !== undefined) {
      if (updateData.apple === null) {
        // Apple-Daten entfernen
        updatedCard.apple = { id: "", uri: "" };
      } else {
        updatedCard.apple = {
          id: updateData.apple.id || existingCard.apple?.id || "",
          uri: updateData.apple.uri || existingCard.apple?.uri || ""
        };
      }
    }

    // Card ersetzen
    data.cards[cardIndex] = updatedCard;

    // Datei speichern
    await fs.writeFile(filePath, JSON.stringify(data, null, 2), 'utf-8');

    res.json({
      message: 'Card erfolgreich aktualisiert',
      filename: filename,
      edition: data.edition,
      card: updatedCard
    });
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Aktualisieren der Card', 
      details: error.message 
    });
  }
});

// Route: Spotify Playlist Sync (POST /api/files/:filename/spotify-sync)
app.post('/api/files/:filename/spotify-sync', authenticateApiKey, async (req, res) => {
  try {
    const { filename } = req.params;

    // Validierung: Filename darf nicht import sein
    if (filename === 'hitster-de-import.json') {
      return res.status(400).json({ 
        error: 'Ungültiger Dateiname',
        message: 'Import-Datei kann nicht synchronisiert werden'
      });
    }

    // Validierung: Filename muss hitster-de*.json sein
    if (!filename.match(/^hitster-de.*\.json$/)) {
      return res.status(400).json({ 
        error: 'Ungültiger Dateiname',
        message: 'Dateiname muss dem Muster hitster-de*.json entsprechen'
      });
    }

    const filePath = path.join(DATA_DIR, filename);

    // Prüfe ob Datei existiert
    try {
      await fs.access(filePath);
    } catch {
      return res.status(404).json({ 
        error: 'Datei nicht gefunden',
        filename: filename 
      });
    }

    // Datei laden
    const fileContent = await fs.readFile(filePath, 'utf-8');
    const data = JSON.parse(fileContent);

    // Prüfe ob spotify_playlist URL vorhanden ist
    if (!data.spotify_playlist || data.spotify_playlist === '') {
      return res.status(400).json({
        error: 'Keine Spotify Playlist URL',
        message: 'Das Feld "spotify_playlist" ist leer oder nicht vorhanden'
      });
    }

    // Extrahiere Playlist ID
    const playlistId = extractPlaylistId(data.spotify_playlist);
    if (!playlistId) {
      return res.status(400).json({
        error: 'Ungültige Spotify Playlist URL',
        message: 'Konnte Playlist ID nicht aus URL extrahieren'
      });
    }

    // Lade Playlist Tracks von Spotify
    console.log(`Lade Tracks von Spotify Playlist ${playlistId}...`);
    const playlistTracks = await getSpotifyPlaylistTracks(playlistId);
    console.log(`${playlistTracks.length} Tracks von Spotify geladen`);

    // Statistiken
    let updated = 0;
    let skipped = 0;
    let notFound = 0;
    const updateDetails = [];

    // Hilfsfunktion: Levenshtein-Distanz berechnen
    const levenshteinDistance = (str1, str2) => {
      const matrix = [];
      for (let i = 0; i <= str2.length; i++) {
        matrix[i] = [i];
      }
      for (let j = 0; j <= str1.length; j++) {
        matrix[0][j] = j;
      }
      for (let i = 1; i <= str2.length; i++) {
        for (let j = 1; j <= str1.length; j++) {
          if (str2.charAt(i - 1) === str1.charAt(j - 1)) {
            matrix[i][j] = matrix[i - 1][j - 1];
          } else {
            matrix[i][j] = Math.min(
              matrix[i - 1][j - 1] + 1,
              matrix[i][j - 1] + 1,
              matrix[i - 1][j] + 1
            );
          }
        }
      }
      return matrix[str2.length][str1.length];
    };

    // Hilfsfunktion: Ähnlichkeit in Prozent (0-100)
    const similarity = (str1, str2) => {
      const longer = str1.length > str2.length ? str1 : str2;
      const shorter = str1.length > str2.length ? str2 : str1;
      if (longer.length === 0) return 100;
      const distance = levenshteinDistance(longer, shorter);
      return ((longer.length - distance) / longer.length) * 100;
    };

    // Iteriere über alle Cards
    for (let i = 0; i < data.cards.length; i++) {
      const card = data.cards[i];
      
      // Überspringe Cards die bereits Spotify-Daten haben
      if (card.spotify?.id && card.spotify.id !== '') {
        skipped++;
        continue;
      }

      // Versuche Track in Playlist zu finden basierend auf Artist und Title
      // Versuche zuerst exaktes Matching, dann Fuzzy-Matching
      let matchedTrack = null;
      let bestMatch = null;
      let bestScore = 0;

      for (const track of playlistTracks) {
        const trackArtists = track.artists.toLowerCase();
        const trackName = track.name.toLowerCase();
        const cardArtist = (card.artist || '').toLowerCase();
        const cardTitle = (card.title || '').toLowerCase();

        // Normalisiere Strings (entferne feat./ft., Sonderzeichen, extra Leerzeichen)
        const normalizeString = (str) => {
          return str
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // Entferne Akzente (é→e, à→a)
            .replace(/\s*\(?\s*(feat\.|ft\.|featuring)\s+[^)]*\)?/gi, '') // Entferne feat.
            .replace(/p!nk/gi, 'pink') // Normalisiere P!nk zu Pink
            .replace(/[^\w\s]/g, ' ') // Ersetze Sonderzeichen mit Leerzeichen
            .replace(/\s+/g, ' ') // Mehrfache Leerzeichen zu einem
            .trim();
        };

        const normalizedTrackName = normalizeString(trackName);
        
        // Extrahiere Text in Klammern aus Titel (z.B. "Grease (Summer Nights)" -> "Summer Nights")
        // Dies ist oft der eigentliche Song-Titel bei Soundtracks
        let titleForMatching = cardTitle;
        const parenthesesMatch = cardTitle.match(/\(([^)]+)\)/);
        if (parenthesesMatch) {
          titleForMatching = parenthesesMatch[1]; // Verwende Text in Klammern
        }
        const normalizedCardTitle = normalizeString(titleForMatching);
        
        // Extrahiere Haupt-Artist (vor "&", ",")
        const mainArtist = normalizeString(cardArtist.split(/[&,]/)[0]);
        const normalizedTrackArtists = normalizeString(trackArtists);

        // Exaktes Matching (bevorzugt)
        const titleMatch = normalizedTrackName.includes(normalizedCardTitle) || 
                          normalizedCardTitle.includes(normalizedTrackName);
        const artistMatch = normalizedTrackArtists.includes(mainArtist) || 
                           normalizeString(cardArtist).includes(normalizedTrackArtists);

        if (titleMatch && artistMatch) {
          matchedTrack = track;
          break; // Exakter Match gefunden, fertig
        }

        // Fuzzy-Matching: Berechne Ähnlichkeit
        const titleSimilarity = similarity(normalizedTrackName, normalizedCardTitle);
        const artistSimilarity = similarity(normalizedTrackArtists, mainArtist);
        
        // Gewichteter Score: Title 60%, Artist 40%
        const score = (titleSimilarity * 0.6) + (artistSimilarity * 0.4);
        
        // Mindestens 70% Ähnlichkeit erforderlich (gesenkt für bessere Matches)
        if (score > bestScore && score >= 70) {
          bestScore = score;
          bestMatch = track;
        }
      }

      // Verwende besten Fuzzy-Match falls kein exakter Match gefunden wurde
      if (!matchedTrack && bestMatch) {
        matchedTrack = bestMatch;
      }

      // Fallback: Wenn immer noch kein Match, verwende Track an derselben Position in der Playlist
      // (Card-ID entspricht Position in Playlist)
      if (!matchedTrack && i < playlistTracks.length) {
        matchedTrack = playlistTracks[i];
      }

      if (matchedTrack) {
        // Update Card mit Spotify-Daten
        card.spotify = {
          id: matchedTrack.id,
          uri: matchedTrack.uri,
          url: matchedTrack.url
        };
        updated++;
        updateDetails.push({
          cardId: card.id,
          title: card.title,
          artist: card.artist,
          spotifyTrack: matchedTrack.name,
          spotifyArtists: matchedTrack.artists
        });
      } else {
        notFound++;
      }
    }

    // Datei speichern wenn Updates vorgenommen wurden
    if (updated > 0) {
      await fs.writeFile(filePath, JSON.stringify(data, null, 2), 'utf-8');
    }

    res.json({
      message: 'Spotify Sync abgeschlossen',
      filename: filename,
      edition: data.edition,
      playlistId: playlistId,
      playlistUrl: data.spotify_playlist,
      statistics: {
        totalCards: data.cards.length,
        updated: updated,
        skipped: skipped,
        notFound: notFound,
        playlistTracks: playlistTracks.length
      },
      updates: updateDetails
    });
  } catch (error) {
    console.error('Fehler beim Spotify Sync:', error);
    res.status(500).json({ 
      error: 'Fehler beim Spotify Sync', 
      details: error.message 
    });
  }
});

// Route: iTunes/Apple Music Sync (POST /api/files/:filename/itunes-sync)
app.post('/api/files/:filename/itunes-sync', authenticateApiKey, async (req, res) => {
  try {
    const { filename } = req.params;
    const { country = 'de' } = req.body; // Optionaler Country-Code

    // Validierung: Filename darf nicht import sein
    if (filename === 'hitster-de-import.json') {
      return res.status(400).json({ 
        error: 'Ungültiger Dateiname',
        message: 'Import-Datei kann nicht synchronisiert werden'
      });
    }

    // Validierung: Filename muss hitster-de*.json sein
    if (!filename.match(/^hitster-de.*\.json$/)) {
      return res.status(400).json({ 
        error: 'Ungültiger Dateiname',
        message: 'Dateiname muss dem Muster hitster-de*.json entsprechen'
      });
    }

    const filePath = path.join(DATA_DIR, filename);

    // Prüfe ob Datei existiert
    try {
      await fs.access(filePath);
    } catch {
      return res.status(404).json({ 
        error: 'Datei nicht gefunden',
        filename: filename 
      });
    }

    // Datei laden
    const fileContent = await fs.readFile(filePath, 'utf-8');
    const data = JSON.parse(fileContent);

    // Statistiken
    let updated = 0;
    let skipped = 0;
    let notFound = 0;
    const updateDetails = [];

    console.log(`iTunes Sync gestartet für ${filename} (${data.cards.length} Cards)`);

    // Iteriere über alle Cards
    for (const card of data.cards) {
      // Überspringe Cards die bereits iTunes-Daten haben
      if (card.apple?.id && card.apple.id !== '') {
        skipped++;
        continue;
      }

      // Suche Track in iTunes Search API
      const itunesTrack = await searchItunesTrack(card.title || '', card.artist || '', country);

      if (itunesTrack) {
        // Update Card mit iTunes-Daten
        card.apple = {
          id: itunesTrack.id,
          uri: itunesTrack.uri
        };
        updated++;
        updateDetails.push({
          cardId: card.id,
          title: card.title,
          artist: card.artist,
          itunesTrack: itunesTrack.name,
          itunesArtist: itunesTrack.artist
        });
      } else {
        notFound++;
        console.log(`iTunes: Card ${card.id} nicht gefunden: "${card.title}" - ${card.artist}`);
      }

      // Rate Limiting: 1 Request pro Sekunde für iTunes API (zu schnell = 403 Fehler)
      await new Promise(resolve => setTimeout(resolve, 1000));
    }

    // Datei speichern wenn Updates vorgenommen wurden
    if (updated > 0) {
      await fs.writeFile(filePath, JSON.stringify(data, null, 2), 'utf-8');
    }

    res.json({
      message: 'iTunes Sync abgeschlossen',
      filename: filename,
      edition: data.edition,
      country: country,
      statistics: {
        totalCards: data.cards.length,
        updated: updated,
        skipped: skipped,
        notFound: notFound
      },
      updates: updateDetails
    });
  } catch (error) {
    console.error('Fehler beim iTunes Sync:', error);
    res.status(500).json({ 
      error: 'Fehler beim iTunes Sync', 
      details: error.message 
    });
  }
});

// Route: iTunes Search für einzelne Card (GET /api/search/itunes)
app.get('/api/search/itunes', authenticateApiKey, async (req, res) => {
  try {
    const { title, artist, country = 'de' } = req.query;

    if (!title || !artist) {
      return res.status(400).json({
        error: 'Fehlende Parameter',
        message: 'title und artist sind erforderlich'
      });
    }

    console.log(`iTunes Search: "${title}" - ${artist}`);
    
    const result = await searchItunesTrack(String(title), String(artist), String(country));

    if (!result) {
      return res.status(404).json({
        error: 'Nicht gefunden',
        message: 'Kein passender Track in iTunes gefunden',
        searched: { title, artist, country }
      });
    }

    res.json({
      success: true,
      track: result,
      searched: { title, artist, country }
    });
  } catch (error) {
    console.error('Fehler bei iTunes Search:', error);
    res.status(500).json({
      error: 'Fehler bei iTunes Search',
      details: error.message
    });
  }
});

// Health Check
app.get('/health', (req, res) => {
  res.json({ status: 'OK', timestamp: new Date().toISOString() });
});

// Route: API-Key generieren (für App-Registrierung)
app.post('/api/register', async (req, res) => {
  try {
    const { appName, appVersion, deviceId, platform } = req.body;

    // Validierung
    if (!appName || !deviceId) {
      return res.status(400).json({ 
        error: 'Validierungsfehler',
        message: 'appName und deviceId sind erforderlich',
        example: {
          appName: "mucajey iOS",
          appVersion: "1.0.0",
          deviceId: "ABC123-DEF456",
          platform: "iOS"
        }
      });
    }

    // Prüfe ob Device bereits registriert ist
    const existingKey = apiKeysStore.keys.find(k => k.deviceId === deviceId);
    
    if (existingKey) {
      // Device bereits registriert - gebe existierenden Key zurück
      return res.json({
        message: 'Device bereits registriert',
        apiKey: existingKey.key,
        registeredAt: existingKey.createdAt,
        appName: existingKey.appName,
        status: 'existing'
      });
    }

    // Generiere neuen API-Key
    const newApiKey = generateSecureApiKey();
    const timestamp = new Date().toISOString();

    // Erstelle Key-Eintrag
    const keyEntry = {
      key: newApiKey,
      appName: appName,
      appVersion: appVersion || 'unknown',
      deviceId: deviceId,
      platform: platform || 'unknown',
      createdAt: timestamp,
      lastUsed: null,
      active: true
    };

    // Füge Key hinzu
    apiKeysStore.keys.push(keyEntry);
    await saveApiKeys();

    res.status(201).json({
      message: 'API-Key erfolgreich generiert',
      apiKey: newApiKey,
      appName: appName,
      deviceId: deviceId,
      createdAt: timestamp,
      status: 'new'
    });
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Generieren des API-Keys', 
      details: error.message 
    });
  }
});

