    // Überspringe API-Routen und Health-Check
    if (edition === 'api' || edition === 'health' || edition === 'scan') {
      return res.status(404).json({ error: 'Route nicht gefunden' });
    }
    
    // Dateiname basierend auf Edition erstellen
    const filename = `hitster-de-${edition}.json`;
    
    let data;
    try {
      // Versuche spezifische Edition zu laden
      data = await loadJsonFile(filename);
    } catch (error) {
      if (error.code === 'ENOENT') {
        // Falls Edition nicht gefunden, versuche in Haupt-Datei zu suchen
        data = await loadJsonFile('hitster-de.json');
      } else {
        throw error;
      }
    }
    
    // Karte in den Daten suchen
    const card = data.cards.find(c => c.id === cardId);
    
    if (card) {
      res.json({
        edition: data.edition || edition,
        scanCode: `${edition}/${cardId}`,
        card: card
      });
    } else {
      res.status(404).json({ 
        error: 'Karte nicht gefunden',
        scanCode: `${edition}/${cardId}`,
        edition: edition,
        cardId: cardId
      });
    }
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Laden der gescannten Karte', 
      details: error.message 
    });
  }
});

// Route: Neue Karte in Import-Datei hinzufügen
app.post('/api/cards', authenticateApiKey, async (req, res) => {
  try {
    const newCard = req.body;
    
    // Validierung
    const validationErrors = validateCard(newCard);
    if (validationErrors.length > 0) {
      return res.status(400).json({ 
        error: 'Validierungsfehler',
        details: validationErrors 
      });
    }
    
    // Import-Datei laden
    const importData = await loadImportFile();
    
    // Prüfe ob Karte bereits existiert (für Update vs. Neuanlage)
    const existingImportIndex = importData.imports.findIndex(
      imp => imp.card.id === newCard.id
    );
    
    const isUpdate = existingImportIndex !== -1;
    const importId = generateImportId();
    const timestamp = new Date().toISOString();
    
    // Erstelle Import-Eintrag
    const importEntry = {
      importId: importId,
      type: isUpdate ? 'update' : 'new',
      timestamp: timestamp,
      card: {
        id: newCard.id,
        title: newCard.title,
        artist: newCard.artist,
        year: newCard.year,
        edition: newCard.edition,
        language_short: newCard.language_short,
        language_long: newCard.language_long,
        apple: newCard.apple || { id: "", uri: "" },
        spotify: newCard.spotify || { id: "", uri: "" }
      }
    };
    
    // Wenn Update, ersetze den alten Eintrag
    if (isUpdate) {
      importData.imports[existingImportIndex] = importEntry;
    } else {
      // Ansonsten füge neuen Eintrag hinzu
      importData.imports.push(importEntry);
    }
    
    // Speichern
    await saveImportFile(importData);
    
    res.status(isUpdate ? 200 : 201).json({
      message: isUpdate ? 'Karte wurde aktualisiert' : 'Neue Karte wurde hinzugefügt',
      importId: importId,
      type: isUpdate ? 'update' : 'new',
      timestamp: timestamp,
      card: importEntry.card,
      totalImports: importData.imports.length,
      file: 'hitster-de-import.json'
    });
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Hinzufügen der Karte', 
      details: error.message 
    });
  }
});

// Route: Alle Karten aus der Import-Datei abrufen
app.get('/api/import', authenticateApiKey, async (req, res) => {
  try {
    const importData = await loadImportFile();
    res.json(importData);
  } catch (error) {
    res.status(500).json({ 
      error: 'Fehler beim Laden der Import-Datei', 
      details: error.message 
    });
  }
});

